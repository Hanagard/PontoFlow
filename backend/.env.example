# Configuração do backend — copie para backend/.env e preencha.
# NUNCA faça commit do .env real (senhas, segredos, chaves).

# MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"

# Origens permitidas (separadas por vírgula). Em produção use o domínio exato, não "*".
CORS_ORIGINS="http://localhost:3000"

# Segredo da sessão (HS256). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET="troque-por-um-valor-aleatorio-de-64-caracteres"

APP_ENV="development"

# Fuso horário padrão da plataforma (cada empresa pode ter o seu).
APP_TZ="America/Belem"
